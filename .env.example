# OpenAI-compatible text/vision service. Never commit a real key.
ROSCLAW_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ROSCLAW_LLM_MODEL=<text-model-id>
ROSCLAW_LLM_API_KEY=<your-api-key>

# Vision mode overrides/fallbacks.
DASHSCOPE_VL_MODEL=qwen-vl-plus
# DASHSCOPE_API_KEY=<your-api-key>  # Used only if ROSCLAW_LLM_API_KEY is absent.
